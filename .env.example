# ── Network ────────────────────────────────────────────────
# testnet = Celo Sepolia (USDC only), mainnet = Celo (USA₮). Develop on testnet first.
X402_NETWORK=testnet

# ── x402 facilitator (https://x402.celo.org → "Create API key") ──
X402_API_KEY=x402_...
# Wallet that RECEIVES payments (your treasury). Not the facilitator.
PAY_TO_ADDRESS=0xYourTreasuryWallet

# ── HTTP ───────────────────────────────────────────────────
PORT=3000
# Public URL the Telegram user opens to pay (use ngrok/cloudflared in dev)
PUBLIC_URL=http://localhost:3000

# ── Telegram (@BotFather) ──────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── OpenCode workers ───────────────────────────────────────
# Leave empty to let the backend spawn `opencode serve` itself.
# Or run `opencode serve --port 4096` yourself and set: OPENCODE_URL=http://127.0.0.1:4096
OPENCODE_URL=
# provider/model the brand agent uses (must be configured in your opencode auth)
OPENCODE_MODEL=anthropic/claude-sonnet-5-5
OPENCODE_TIMEOUT_MS=600000
WORKER_CONCURRENCY=2

# ── Free trial ─────────────────────────────────────────────
# First N tasks per Telegram user are free (0 = off); global daily cap bounds LLM cost.
FREE_TRIAL_TASKS=1
FREE_TRIAL_DAILY_CAP=50

# ── Chat with your agent ───────────────────────────────────
CHAT_DAILY_LIMIT=30
FREE_REVISIONS=2

# ── ERC-8004 identity (filled after `npm run register-agent`) ──
AGENT_ID=
# Only needed for scripts/register-agent.ts (never used by the server)
REGISTRAR_PRIVATE_KEY=

# ── Rendering (flyers → PNG, promo videos → MP4) ──────────
# Auto-detected on macOS/Linux; set if Chrome lives elsewhere.
CHROME_PATH=
FFMPEG_PATH=ffmpeg

# ── Storage ────────────────────────────────────────────────
DATABASE_PATH=./data/app.db

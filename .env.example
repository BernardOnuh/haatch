# ── Network ────────────────────────────────────────────────
# testnet = Celo Sepolia (USDC only), mainnet = Celo (USA₮). Develop on testnet first.
X402_NETWORK=testnet

# ── x402 facilitator (https://x402.celo.org → "Create API key") ──
X402_API_KEY=x402_...
# Wallet that RECEIVES payments (your treasury). Not the facilitator.
PAY_TO_ADDRESS=0xYourTreasuryWallet

# ── HTTP ───────────────────────────────────────────────────
PORT=3000
# Public URL the Telegram user opens to pay (use ngrok/cloudflared in dev)
PUBLIC_URL=http://localhost:3000

# ── Telegram (@BotFather) ──────────────────────────────────
TELEGRAM_BOT_TOKEN=
# polling (always-on machine) or webhook (hosts that sleep when idle, e.g. Render free)
TELEGRAM_MODE=polling

# ── OpenCode workers ───────────────────────────────────────
# Leave empty to let the backend spawn `opencode serve` itself.
# Or run `opencode serve --port 4096` yourself and set: OPENCODE_URL=http://127.0.0.1:4096
OPENCODE_URL=
# provider/model the brand agent uses (must be configured in your opencode auth)
OPENCODE_MODEL=anthropic/claude-sonnet-5-5
OPENCODE_TIMEOUT_MS=600000
WORKER_CONCURRENCY=2
# true on small hosts (Render free, 512 MB): one job at a time, no video
LOW_MEMORY=false

# ── Free trial ─────────────────────────────────────────────
# First N tasks per Telegram user are free (0 = off); global daily cap bounds LLM cost.
FREE_TRIAL_TASKS=3
FREE_TRIAL_DAILY_CAP=50

# ── Chat with your agent ───────────────────────────────────
CHAT_DAILY_LIMIT=30
FREE_REVISIONS=2

# ── ERC-8004 identity (filled after `npm run register-agent`) ──
AGENT_ID=
# Only needed for scripts/register-agent.ts (never used by the server)
REGISTRAR_PRIVATE_KEY=

# ── Rendering (flyers → PNG, promo videos → MP4) ──────────
# Auto-detected on macOS/Linux; set if Chrome lives elsewhere.
CHROME_PATH=
FFMPEG_PATH=ffmpeg

# ── Hackathon (Agents on Open Rails) ───────────────────────
# ERC-8021 attribution code from your Loops registration — appended to every tx we send.
ATTRIBUTION_CODE=
# Protects /register-agent (register the ERC-8004 identity from your own wallet).
ADMIN_TOKEN=

# ── Self proof-of-human gate (optional) ────────────────────
# Require a valid Self Agent ID proof (x-self-agent-* headers) on POST /api/tasks.
# Off by default so the live flow never depends on Self RPCs. See src/identity/self.ts.
SELF_REQUIRED=false
# mainnet | testnet (defaults to the payment network's chain)
SELF_NETWORK=
# Max agents one human may run against this service (0 disables sybil check).
SELF_SYBIL_LIMIT=1
# Require the human to be at least this old (0/empty = no age check).
SELF_MIN_AGE=

# ── Storage ────────────────────────────────────────────────
DATABASE_PATH=./data/app.db

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

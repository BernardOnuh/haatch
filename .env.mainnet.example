# ── haatch — Celo MAINNET (USA₮ + x402) ────────────────────
# Copy to `.env` when you are ready for the first real settlement:
#   cp .env.mainnet.example .env
# Then fill the placeholders. Never commit `.env`.

# ── Network ────────────────────────────────────────────────
# mainnet = Celo (chain 42220), asset USA₮ (6 decimals)
X402_NETWORK=mainnet

# ── x402 facilitator (https://x402.celo.org → "Create API key") ──
X402_API_KEY=x402_REPLACE_ME

# Wallet that RECEIVES payments (your treasury — NOT the agent wallet unless you want it to be)
PAY_TO_ADDRESS=0xREPLACE_ME

# ── HTTP ───────────────────────────────────────────────────
PORT=3000
# Public https URL of the deployed server (Render sets RENDER_EXTERNAL_URL automatically)
PUBLIC_URL=https://REPLACE_ME

# ── Telegram ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_MODE=webhook

# ── Agent engine ───────────────────────────────────────────
AGENT_ENGINE=opencode
OPENCODE_MODEL=anthropic/claude-sonnet-5-5
OPENCODE_TIMEOUT_MS=600000
WORKER_CONCURRENCY=2
LOW_MEMORY=false

# Trial / limits — set FREE_TRIAL_TASKS=0 on mainnet if you don't want free real-money work
FREE_TRIAL_TASKS=0
FREE_TRIAL_DAILY_CAP=50
CHAT_DAILY_LIMIT=30
FREE_REVISIONS=2

# ── ERC-8004 identity ──────────────────────────────────────
# Filled after `REGISTRAR_PRIVATE_KEY=... npm run register-agent` on mainnet.
AGENT_ID=
# Used only by scripts/register-agent.ts. This wallet needs a little CELO for gas.
# Register from the AGENT wallet (0x8867D0EBa274a509f7ab384D427bdbc9485b9D3a) so the
# tagged registration tx shows up under the entry's agent wallet.
REGISTRAR_PRIVATE_KEY=0xREPLACE_ME

# ── Rendering ──────────────────────────────────────────────
CHROME_PATH=
FFMPEG_PATH=ffmpeg

# ── Hackathon (Agents on Open Rails) ───────────────────────
# ERC-8021 attribution code assigned by Loops. Required on every tx the app sends.
ATTRIBUTION_CODE=celo_4381b7971760
# Protects /register-agent
ADMIN_TOKEN=REPLACE_ME

# ── Self proof-of-human gate (optional but recommended for the USA₮ track) ──
# Requires x-self-agent-* headers on POST /api/tasks. Mainnet accepts real passports/IDs only.
SELF_REQUIRED=true
SELF_NETWORK=mainnet
SELF_SYBIL_LIMIT=1
SELF_MIN_AGE=

# ── Storage ────────────────────────────────────────────────
DATABASE_PATH=./data/app.db

# ── Buyer test (scripts/test-pay.ts) ───────────────────────
# A separate, named counterparty wallet funded with USA₮ — the "named counterparty" the judges look for.
BUYER_PRIVATE_KEY=0xREPLACE_ME

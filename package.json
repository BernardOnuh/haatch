{
  "name": "startup-task-agents",
  "version": "1.0.0",
  "description": "Startup Task Agents: x402 (USA₮ on Celo) paid branding tasks executed by OpenCode agents",
  "scripts": {
    "dev": "npm run build:pay && tsx watch src/index.ts",
    "start": "npm run build:pay && tsx src/index.ts",
    "build:pay": "esbuild src/web/pay-client.ts --bundle --format=esm --target=es2022 --outfile=public/pay.js --minify && esbuild src/web/register-client.ts --bundle --format=esm --target=es2022 --outfile=public/register.js --minify",
    "typecheck": "tsc --noEmit",
    "register-agent": "tsx scripts/register-agent.ts",
    "test-pay": "tsx scripts/test-pay.ts",
    "test-worker": "tsx scripts/test-worker.ts",
    "demo-wallet": "tsx scripts/demo-wallet.ts",
    "build": "npm run build:pay && esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/index.js",
    "start:prod": "node --max-old-space-size=160 dist/index.js"
  },
  "type": "module",
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@opencode-ai/sdk": "^1.19.4",
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/fetch": "^2.28.0",
    "@x402/hono": "^2.28.0",
    "dotenv": "^18.0.9",
    "grammy": "^1.46.0",
    "hono": "^4.13.14",
    "puppeteer-core": "^25.16.0",
    "undici": "^7.30.1",
    "viem": "^2.57.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true
}
